# cmake/wamr/wasi/shared_platform.cmake -- WAMR's platform layer for the
# wasm32 build (cmake/wamr/CMakeLists.txt sets SHARED_PLATFORM_CONFIG to
# this file).  The runtime then runs inside the module: one thread at a
# time, memory from malloc, the time from the C library.

set(PLATFORM_SHARED_DIR ${CMAKE_CURRENT_LIST_DIR})

add_definitions(-DBH_PLATFORM_EIDOS_WASI)

include_directories(${PLATFORM_SHARED_DIR})
include_directories(${SHARED_DIR}/platform/include)

# WAMR declares WASI's types itself (platform_wasi_types.h), with other base
# types than the C library's <wasi/api.h>, so platform_internal.h keeps
# that header out.  The C library's <errno.h> still spells its values with
# the header's __WASI_ERRNO_ names: those lines alone, from this sysroot.
find_file(_eidos_wasi_api_h wasi/api.h
          PATHS ${CMAKE_SYSROOT} ${WASI_SDK_PREFIX}/share/wasi-sysroot
          PATH_SUFFIXES include/wasm32-wasip1 include
          NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
file(STRINGS "${_eidos_wasi_api_h}" _eidos_wasi_errno
     REGEX "^#define __WASI_ERRNO_")
string(REPLACE ";" "\n" _eidos_wasi_errno "${_eidos_wasi_errno}")
file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/eidos_wasi_errno.h
     "/* generated by cmake/wamr/wasi/shared_platform.cmake */\n#include <stdint.h>\n${_eidos_wasi_errno}\n")
include_directories(${CMAKE_CURRENT_BINARY_DIR})

include(${SHARED_DIR}/platform/common/memory/platform_api_memory.cmake)

set(PLATFORM_SHARED_SOURCE ${PLATFORM_SHARED_DIR}/wasi_platform.c
    ${PLATFORM_COMMON_MEMORY_SOURCE})
