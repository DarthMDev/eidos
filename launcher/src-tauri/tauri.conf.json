{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eidos launcher",
  "version": "0.1.0",
  "identifier": "org.holon.eidos.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "eidos launcher",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["eidos"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "app"],
    "category": "Game",
    "shortDescription": "Profiles, versions and mods for eidos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
